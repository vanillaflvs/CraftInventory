<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CraftInventory</title>

    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">

    <script defer src="/javascripts/inventory.js"></script>
</head>

<body>

    <div class="mc-scenery"></div>
    <div class="mc-vignette"></div>

    <section id="login" class="login-screen">

        <div class="login-content">

            <h1 class="minecraft-title">CRAFTINVENTORY</h1>

            <p class="splash">Your inventory, your world!</p>

            <form id="loginForm" class="login-form">

                <label for="nickname">Nome do jogador</label>

                <input type="text" id="nickname" placeholder="Steve" maxlength="50" autocomplete="username" required>

                <label for="senha">Senha</label>

                <input type="password" id="senha" placeholder="Senha" minlength="6" autocomplete="current-password"
                    required>

                <button type="submit" class="mc-button">
                    Entrar no mundo
                </button>

                <button type="button" id="cadastro" class="mc-button">
                    Criar jogador
                </button>

                <p id="loginStatus" role="status"></p>

            </form>

        </div>

        <div class="login-footer">
            CraftInventory 1.0
        </div>

    </section>

    <main id="game" hidden>

        <header class="game-header">

            <span id="player"></span>

            <div class="header-buttons">

                <button id="perfil" class="mc-button">
                    Editar jogador
                </button>

                <button id="logout" class="mc-button">
                    Salvar e sair
                </button>

            </div>

        </header>

        <div class="game-layout">

            <div class="player-area">

                <section class="mc-window">

                    <div class="mc-top-section">

                        <div id="armor" class="mc-armor-col"></div>

                        <div class="mc-player-box"></div>

                        <div class="slot offhand">

                            <svg class="slot-silhouette" viewBox="0 0 16 16" fill="#4A4A4A">

                                <path d="M3 2h10v7c0 3-5 5-5 5s-5-2-5-5V2zm2 2v4c0 1.5 3 3 3 3s3-1.5 3-3V4H5z" />

                            </svg>

                        </div>

                    </div>

                    <div class="mc-main-section">

                        <div id="slots" class="mc-grid-9"></div>

                    </div>

                    <div class="mc-hotbar-section">

                        <div id="hotbar" class="mc-grid-9"></div>

                    </div>

                </section>

                <div class="hud">

                    <div class="hud-status">

                        <div class="hearts">

                            <% for (let i=0; i < 10; i++) { %>
                                <span>♥</span>
                                <% } %>

                        </div>

                        <div class="experience">

                            <span id="nivelHud">0</span>

                        </div>

                    </div>

                    <div id="hudHotbar" class="hud-hotbar" hidden></div>

                </div>

                <p id="status" role="status"></p>

            </div>

            <aside class="jei-sidebar">

                <div class="jei-header">

                    <button type="button" class="jei-square-btn" id="jeiPrevPageBtn" title="Página anterior">

                        <svg viewBox="0 0 16 16">
                            <polygon points="11,3 5,8 11,13" fill="#FFFFFF" />
                        </svg>

                    </button>

                    <span id="jeiPageIndicator" class="jei-page-indicator">
                        1/1
                    </span>

                    <button type="button" class="jei-square-btn" id="jeiNextPageBtn" title="Próxima página">

                        <svg viewBox="0 0 16 16">
                            <polygon points="5,3 11,8 5,13" fill="#FFFFFF" />
                        </svg>

                    </button>

                </div>

                <div id="catalog" class="jei-grid"></div>

                <div class="jei-footer">

                    <input id="search" class="jei-search" type="search" placeholder="Pesquisar..." autocomplete="off">

                    <button type="button" class="jei-square-btn" id="configButton" title="Editar jogador">

                        <svg viewBox="0 0 16 16">

                            <path
                                d="M9 1h3v1h1v3h-1v1h-2v1H9v1H8v1H7v1H6v1H5v2H3v1H2v-1H1v-2h1v-1h2V9h1V8h1V7h1V6h1V4h1V2h1V1z"
                                fill="#1E1E1E" />

                            <path d="M10 2h2v1h-1v2h2v1h-2v1H9v1H8v1H7v1H6v1H5v1H3v1H2v-1h1v-2h1V9h1V8h1V7h1V6h1V4h1V2z"
                                fill="#A8A8A8" />

                        </svg>

                    </button>

                </div>

            </aside>

        </div>

    </main>

    <dialog id="editor" class="mc-dialog">

        <form id="editForm" class="mc-qty-box">

            <h2 id="modalTitle">Adicionar item</h2>

            <div class="item-preview">

                <img id="previewImage" alt="">

                <span id="previewName"></span>

            </div>

            <label for="quantity">Quantidade</label>

            <div class="mc-qty-controls">

                <button type="button" class="jei-square-btn" id="minusQty">
                    -1
                </button>

                <input id="quantity" class="mc-qty-input" type="number" min="1" max="64" value="1" required>

                <button type="button" class="jei-square-btn" id="plusQty">
                    +1
                </button>

            </div>

            <div class="quantity-buttons">

                <button type="button" class="mc-button" data-qty="1">1</button>
                <button type="button" class="mc-button" data-qty="16">16</button>
                <button type="button" class="mc-button" data-qty="32">32</button>
                <button type="button" class="mc-button" data-qty="64">64</button>

            </div>

            <div class="mc-qty-actions">

                <button type="button" id="cancel" class="mc-button">
                    Cancelar
                </button>

                <button type="submit" class="mc-button">
                    Confirmar
                </button>

            </div>

            <button type="button" id="remove" class="mc-button danger">

                Excluir item

            </button>

        </form>

    </dialog>

    <dialog id="perfilDialog" class="profile-dialog">

        <form id="perfilForm" class="login-form">

            <h2>Editar jogador</h2>

            <label for="perfilNome">Apelido</label>

            <input id="perfilNome" type="text" maxlength="50" required>

            <label for="perfilVida">Vida (0 a 20)</label>

            <input id="perfilVida" type="number" min="0" max="20" step="0.5" required>

            <label for="perfilNivel">Nível</label>

            <input id="perfilNivel" type="number" min="0" max="2147483647" required>

            <label for="senhaAtual">Senha atual</label>

            <input id="senhaAtual" type="password" autocomplete="current-password">

            <label for="novaSenha">Nova senha</label>

            <input id="novaSenha" type="password" minlength="6" placeholder="Opcional" autocomplete="new-password">

            <p id="perfilStatus" role="status"></p>

            <button type="submit" class="mc-button">
                Salvar alterações
            </button>

            <button type="button" id="fecharPerfil" class="mc-button">

                Voltar ao inventário

            </button>

        </form>

    </dialog>

    <div id="tooltip" class="mc-tooltip" hidden></div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const quantity = document.getElementById('quantity');
            const catalog = document.getElementById('catalog');
            const indicator = document.getElementById('jeiPageIndicator');

            document.getElementById('minusQty').onclick = () => {
                quantity.value = Math.max(
                    1,
                    (Number(quantity.value) || 1) - 1
                );
            };

            document.getElementById('plusQty').onclick = () => {
                quantity.value = Math.min(
                    Number(quantity.max),
                    (Number(quantity.value) || 1) + 1
                );
            };

            document.getElementById('configButton').onclick = () => {
                document.getElementById('perfil').click();
            };

            function atualizarPagina() {
                const altura = catalog.clientHeight;

                if (!altura) return;

                const total = Math.max(
                    1,
                    Math.ceil(catalog.scrollHeight / altura)
                );

                const atual = Math.min(
                    total,
                    Math.round(catalog.scrollTop / altura) + 1
                );

                indicator.textContent = atual + '/' + total;
            }

            document.getElementById('jeiPrevPageBtn').onclick = () => {
                catalog.scrollBy({
                    top: -catalog.clientHeight,
                    behavior: 'smooth'
                });
            };

            document.getElementById('jeiNextPageBtn').onclick = () => {
                catalog.scrollBy({
                    top: catalog.clientHeight,
                    behavior: 'smooth'
                });
            };

            catalog.addEventListener('scroll', atualizarPagina);

            document.getElementById('search').addEventListener('input', () => {
                catalog.scrollTop = 0;
                atualizarPagina();
            });

            new MutationObserver(atualizarPagina).observe(catalog, {
                childList: true
            });

            new ResizeObserver(atualizarPagina).observe(catalog);
        });
    </script>

</body>

</html>